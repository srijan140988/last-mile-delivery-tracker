# ============================================================
# Last-Mile Delivery Tracker — Environment Variables
# Copy this file to server/.env and fill in real values.
# ============================================================

# --- Server ---
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# --- Database (Postgres — Neon / Supabase / Railway / local) ---
DATABASE_URL="postgresql://user:password@localhost:5432/delivery_tracker?schema=public"

# --- Auth ---
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"
BCRYPT_SALT_ROUNDS=10

# --- Email (Resend or Brevo — leave blank to disable, app still runs) ---
EMAIL_PROVIDER=resend         # "resend" | "smtp" | "none"
RESEND_API_KEY=
EMAIL_FROM="Delivery Tracker <no-reply@example.com>"

# SMTP fallback (e.g. Brevo SMTP relay)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- SMS (Twilio — optional, app runs fine without it) ---
SMS_PROVIDER=twilio            # "twilio" | "none"
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Frontend (client/.env) ---
VITE_API_URL=http://localhost:4000/api
